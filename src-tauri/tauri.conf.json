{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyTwin",
  "version": "0.1.0",
  "identifier": "com.pretheesh.mytwin",
  "build": {
    "frontendDist": "../public",
    "beforeBuildCommand": "node scripts/prepare-local-tts.mjs",
    "beforeDevCommand": "node scripts/prepare-local-tts.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MyTwin",
        "width": 1320,
        "height": 900,
        "minWidth": 800,
        "minHeight": 620,
        "backgroundColor": "#101010",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Video",
    "shortDescription": "Your personal voice and avatar studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "resources": {
      "../local-tts/engine.py": "local-tts/engine.py",
      "../local-tts/catalog.json": "local-tts/catalog.json",
      "../local-tts/pyproject.toml": "local-tts/pyproject.toml",
      "../local-tts/uv.lock": "local-tts/uv.lock",
      "../local-tts/uv": "local-tts/uv",
      "../local-tts/UV-LICENSE-MIT": "local-tts/UV-LICENSE-MIT",
      "../local-tts/UV-LICENSE-APACHE": "local-tts/UV-LICENSE-APACHE"
    }
  }
}
