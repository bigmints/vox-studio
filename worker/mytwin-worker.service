[Unit]
Description=InfiniteTalk MyTwin bounded worker
BindsTo=infinitetalk.service
PartOf=infinitetalk.service
After=infinitetalk.service
[Service]
WorkingDirectory=/home/bigmints/apps/InfiniteTalk
ExecStart=/home/bigmints/apps/InfiniteTalk/.venv/bin/python /home/bigmints/apps/InfiniteTalk/infinitetalk_worker.py
Environment=MYTWIN_WORKER_HOST=100.77.38.96
Environment=MYTWIN_WORKER_PORT=8420
Environment=PYTHONUNBUFFERED=1
UMask=0077
MemoryHigh=36000000000
MemoryMax=40000000000
MemorySwapMax=0
OOMPolicy=kill
TasksMax=256
KillMode=control-group
TimeoutStopSec=15
Restart=no
